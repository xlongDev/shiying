# 时影（抖音解析器）环境变量清单
# 复制为 .env.local（本地）或部署平台的环境变量配置。所有变量均为可选，未设置时走兜底行为。
# 详细说明见 src/lib/config.ts。

# ── 无头浏览器（自托管核心依赖）────────────────────────────
# 显式指定 Chrome 路径；不设则由 chrome-finder 在常见安装路径 / which 中探测。
# 注意：Vercel 等 serverless 环境无系统 Chrome，无法走浏览器兜底。
# PUPPETEER_EXECUTABLE_PATH=
# CHROME_PATH=

# ── 国内 a_bogus 签名桥（serverless / Vercel 的实况解析替代路径）──
# 部署在国内 IP 的 live-photo-service 基址（末尾 / 可选）。配置后实况解析零浏览器。
# LIVE_PHOTO_SERVICE_URL=
# LIVE_PHOTO_SERVICE_TOKEN=

# ── 跨实例限流（可选，不装依赖则回退进程内存限流）─────────────
# 设置后自动启用 Upstash Ratelimit（需先 pnpm add @upstash/ratelimit @upstash/redis）。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── 日志 ─────────────────────────────────────────────────
# 日志阈值：debug | info | warn | error（默认 info）。
# LOG_LEVEL=info

# ── 功能开关 ─────────────────────────────────────────────
# 设为 true 可完全关闭实况照片解析（仅保留基础视频/图文解析）。
# DISABLE_LIVE_PHOTO_RESOLVE=false

# 诊断路由 /api/abogus-test 开关（默认关闭，需设 true 才响应）。
# 该路由会真实调用上游并返回内部签名细节（真实/合成 ttwid 对照实验），
# 用于部署期确认「免浏览器 a_bogus 直连」在您的 IP 是否可用，生产务必关闭。
# ENABLE_DIAGNOSTICS=false

# ── 抖音真实会话凭证（免浏览器 a_bogus 直连的关键）────────────
# 从本机 Chrome DevTools 复制（Application → Cookies，或 Network 请求 URL 里的参数）：
#   DOUYIN_TTWID    ：cookie 名 ttwid 的值，需带 `ttwid=` 前缀（形如 ttwid=1|<base64>|...）。
#                     若从请求 URL 复制，其 %7C 是 | 的 URL 编码，必须解码回字面 | 再写入。
#   DOUYIN_ODIN_TT  ：cookie 名 odin_tt 的值，需带 `odin_tt=` 前缀。
#   DOUYIN_MSTOKEN  ：aweme/detail 近期常要求携带，缺失会返回空响应。
# 三者齐备后 a_bogus 直连才会被服务端接受（200 且有数据）。
# 未配置时：ttwid/odin_tt 走首页自动 bootstrap（WAF 环境会失败 → 空响应），msToken 自动补伪 token。
# DOUYIN_TTWID=ttwid=1|xxxx
# DOUYIN_ODIN_TT=odin_tt=xxxx
# DOUYIN_MSTOKEN=xxxx

# 禁用无头浏览器兜底（默认 false）。设 true 时解析在 SSR + a_bogus 都失败后
# 不再尝试启动 Chrome，直接返回失败。适用于明确「不依赖 Chrome」的部署形态
# （国内部署机走纯 a_bogus 直连；海外 serverless 走国内签名桥），可省去每次
# 请求探测 Chrome 路径的开销与日志噪声。
# DISABLE_BROWSER_FALLBACK=false

# ── 启动期凭证预热（加速首条解析请求）──────────────────────
# 服务启动后，预热逻辑会导航到 douyin.com/video/<此ID> 并实时收割整组自洽会话凭证
# （webid/verifyFp/fp/msToken + cookie 的 ttwid/odin_tt），写入缓存，使首条 /api/parse
# 直接走更快的 a_bogus 桥接（~1s）而非先付浏览器兜底（~13s）。
# 不设则使用内置默认种子（当前环境实测可用的公开视频）；若默认种子失效，可改为你
# 自己的任一公开视频 ID 覆盖。种子仅用于「触发一次 aweme/detail 请求以收割凭证」，
# 与最终解析的目标无关。
# PREWARM_AWEME_ID=
